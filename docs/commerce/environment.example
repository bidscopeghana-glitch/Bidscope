# Server-side only. Do not copy production credentials into the sample preview.
BIDSCOPE_COMMERCE_STORAGE_READY=0
BIDSCOPE_COMMERCE_NOTIFICATIONS_ENABLED=0
# Test verification helper accepts sk_test_ only. Do not reuse subscription keys.
BIDSCOPE_COMMERCE_PAYSTACK_TEST_KEY=
# CJ candidate adapter accepts a short-lived token with explicit expiry.
# The server token manager handles retrieval and refresh from CJ_API_KEY.
CJ_ACCESS_TOKEN=
CJ_ACCESS_TOKEN_EXPIRES_AT=
# Preferred: official API key, exchanged and cached only by the server.
CJ_API_KEY=
# Local-only setup form. Never enable on Vercel or another public server.
BIDSCOPE_COMMERCE_LOCAL_SETUP=0
# Private catalogue jobs only; enable after the reviewed migration is applied.
BIDSCOPE_CATALOGUE_SUPABASE_READY=0
CJ_CATALOGUE_TARGET=50000
CJ_CATALOGUE_BATCH_PAGES=10
# Record permissions and allowed products in commerce.sources, not just flags.
# No environment variable can enable live checkout: route returns 503.
