# Server-only values. Never prefix the secret key with NEXT_PUBLIC_.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_your_server_only_key
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_public_key
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_public_key
NEXT_PUBLIC_SITE_URL=https://www.bidscopeghana.com

# A long random value used only by trusted ingestion, alert and billing jobs.
BIDSCOPE_INTERNAL_SECRET=replace_with_at_least_32_random_characters

# Optional until automated email alerts are enabled.
RESEND_API_KEY=re_your_server_only_key
ALERT_FROM_EMAIL=BidScope Ghana <alerts@bidscopeghana.com>

# Multi-provider AI orchestration. Every value is server-side only. BidScope
# remains operational with deterministic/cached analysis when keys are absent.
GROQ_API_KEY=
BIDSCOPE_GROQ_MODEL=llama-3.3-70b-versatile
GOOGLE_GEMINI_API_KEY=
# Legacy alias accepted during migration: GEMINI_API_KEY
BIDSCOPE_AI_MODEL=gemini-2.5-flash
BIDSCOPE_GEMINI_REASONING_MODEL=gemini-2.5-pro
OPENROUTER_API_KEY=
BIDSCOPE_OPENROUTER_MODEL=google/gemini-2.0-flash-001
BIDSCOPE_OPENROUTER_REASONING_MODEL=
OPENAI_API_KEY=
BIDSCOPE_OPENAI_MODEL=gpt-4.1-mini
BIDSCOPE_OPENAI_REASONING_MODEL=o3

# Vercel scheduler authentication. Use a different strong secret from BIDSCOPE_INTERNAL_SECRET.
CRON_SECRET=

# Paystack is server-only. Paid plans remain disabled until an admin configures
# real GHS prices and corresponding Paystack recurring plan codes.
PAYSTACK_SECRET_KEY=
# Configure this exact endpoint in the Paystack dashboard after test-mode MFA:
# https://www.bidscopeghana.com/api/payments/paystack/webhook

# Official procurement source connectors. Empty values are safe: only the verified
# World Bank official open-data connectors are enabled by default and require no key.
GHANEPS_API_URL=
GHANEPS_API_KEY=
MRH_EBIDS_API_URL=
MRH_EBIDS_API_KEY=
BOG_PROCUREMENT_API_URL=
BOG_PROCUREMENT_API_KEY=
UNGM_API_URL=
UNGM_API_KEY=
AFDB_API_URL=
AFDB_API_KEY=
WORLD_BANK_PROCUREMENT_API_URL=https://search.worldbank.org/api/v2/procnotices
WORLD_BANK_PROJECTS_API_URL=https://search.worldbank.org/api/v2/projects
WORLD_BANK_AWARDS_API_URL=https://datacatalogapi.worldbank.org/dexapps/fone/api/apiservice?datasetId=DS00005&resourceId=RS00005&type=json
WORLD_BANK_MAX_PAGES=25
WORLD_BANK_AWARDS_MAX_PAGES=10
SAM_GOV_API_KEY=
UNGM_MAX_PAGES=3
WORLD_BANK_MAX_PAGES=5
